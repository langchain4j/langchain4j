{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    // the ignorePaths of config:recommended (:ignoreModulesAndTests) without "**/test/**", which would hide
    // the Milvus test image tags in src/test/java from the custom manager below
    "ignorePaths": [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/examples/**",
        "**/__tests__/**",
        "**/tests/**",
        "**/__fixtures__/**"
    ],
    "labels": [
        // add "dependencies" label to PRs
        "dependencies"
    ],
    "timezone": "Europe/Berlin",
    // most bad or hijacked releases are found and pulled within a few days, and Milvus pushes its images days before
    // a release is final; security fixes from GitHub's vulnerability alerts do not wait (vulnerabilityAlerts has no
    // minimumReleaseAge by default)
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            // the JDK versions in the workflows and the dev container features come without a release timestamp, so
            // their release age cannot be checked; without this, their updates would wait for a click on the dashboard
            "matchPackageNames": ["java-jdk", "ghcr.io/devcontainers/features/*"],
            "minimumReleaseAgeBehaviour": "timestamp-optional"
        },
        {
            // each workflow job pins its JDK major on purpose (the 17, 21 and 25 builds)
            "matchPackageNames": ["java-jdk"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            // prPriority sets the order in which Renovate opens PRs while the PR limits (10 open, 2 per hour) hold
            // updates back; higher goes first, the default is 0. Tier 1 (4): core, main module, shared libraries and
            // HTTP clients. Tier 2 (2): the most used integrations. Tier 3 (0): all other modules. Test dependencies
            // are one step below the production ones of their tier, build tooling is with the tier 3 tests.
            "matchDepTypes": ["test"],
            "prPriority": -1
        },
        {
            "matchFileNames": [
                "langchain4j-parent/pom.xml", "langchain4j-core/pom.xml", "langchain4j/pom.xml",
                "langchain4j-http-client/pom.xml", "http-clients/*/pom.xml"
            ],
            "prPriority": 4
        },
        {
            "matchFileNames": [
                "langchain4j-parent/pom.xml", "langchain4j-core/pom.xml", "langchain4j/pom.xml",
                "langchain4j-http-client/pom.xml", "http-clients/*/pom.xml"
            ],
            "matchDepTypes": ["test"],
            "prPriority": 3
        },
        {
            // test libraries that the parent manages without the test scope
            "matchFileNames": ["langchain4j-parent/pom.xml"],
            "matchPackageNames": [
                "org.junit:*", "org.testcontainers:*", "org.mockito:*", "org.assertj:*", "org.awaitility:*",
                "ch.qos.logback:*", "org.tinylog:*", "org.apache.logging.log4j:*"
            ],
            "prPriority": 3
        },
        {
            "matchFileNames": [
                "document-parsers/langchain4j-document-parser-apache-tika/pom.xml", "embeddings/*/pom.xml",
                "langchain4j-agentic/pom.xml", "langchain4j-anthropic/pom.xml", "langchain4j-azure-ai-search/pom.xml",
                "langchain4j-azure-open-ai/pom.xml", "langchain4j-bedrock/pom.xml", "langchain4j-elasticsearch/pom.xml",
                "langchain4j-google-ai-gemini/pom.xml", "langchain4j-google-genai/pom.xml", "langchain4j-mcp/pom.xml",
                "langchain4j-milvus/pom.xml", "langchain4j-mistral-ai/pom.xml", "langchain4j-ollama/pom.xml",
                "langchain4j-open-ai/pom.xml", "langchain4j-open-ai-official/pom.xml", "langchain4j-skills/pom.xml",
                "langchain4j-vertex-ai-gemini/pom.xml"
            ],
            "prPriority": 2
        },
        {
            "matchFileNames": [
                "document-parsers/langchain4j-document-parser-apache-tika/pom.xml", "embeddings/*/pom.xml",
                "langchain4j-agentic/pom.xml", "langchain4j-anthropic/pom.xml", "langchain4j-azure-ai-search/pom.xml",
                "langchain4j-azure-open-ai/pom.xml", "langchain4j-bedrock/pom.xml", "langchain4j-elasticsearch/pom.xml",
                "langchain4j-google-ai-gemini/pom.xml", "langchain4j-google-genai/pom.xml", "langchain4j-mcp/pom.xml",
                "langchain4j-milvus/pom.xml", "langchain4j-mistral-ai/pom.xml", "langchain4j-ollama/pom.xml",
                "langchain4j-open-ai/pom.xml", "langchain4j-open-ai-official/pom.xml", "langchain4j-skills/pom.xml",
                "langchain4j-vertex-ai-gemini/pom.xml"
            ],
            "matchDepTypes": ["test"],
            "prPriority": 1
        },
        {
            // build tooling: Maven plugins (also those in the tier 1 files), GitHub Actions, the Maven wrapper,
            // the docs site, the dev container, the Milvus test image, the integration tests and the internal tools
            "matchDepTypes": ["build"],
            "prPriority": -1
        },
        {
            "matchManagers": ["!maven"],
            "prPriority": -1
        },
        {
            "matchFileNames": ["integration-tests/**", "internal/**"],
            "prPriority": -1
        },
        {
            // majors usually need migration work: they stay last, as by default, so they do not take all the PR slots
            "matchUpdateTypes": ["major"],
            "prPriority": -2
        },
        {
            // Weekly PRs, opened early on Monday so that their CI is done before the Monday review: Maven plugins and
            // the Maven wrapper in one group, the test dependencies in another, and the AWS and Azure SDKs, which
            // release almost daily. Majors stay separate. The other updates always fill the PR limits, so these PRs
            // do not wait for them, and their branches are not updated during the week. The plugins of the
            // integration-test projects stay with the BOM of their framework, which shares their version.
            "matchDepTypes": ["build"],
            "matchFileNames": ["!integration-tests/**"],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "Maven plugins and wrapper",
            "schedule": ["* 0-4 * * 1"],
            "updateNotScheduled": false,
            "prConcurrentLimit": 0,
            "prHourlyLimit": 0
        },
        {
            "matchManagers": ["maven-wrapper"],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "Maven plugins and wrapper",
            "schedule": ["* 0-4 * * 1"],
            "updateNotScheduled": false,
            "prConcurrentLimit": 0,
            "prHourlyLimit": 0
        },
        {
            // the test group takes the test priority of tier 1
            "matchDepTypes": ["test"],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "test dependencies",
            "prPriority": 3,
            "schedule": ["* 0-4 * * 1"],
            "updateNotScheduled": false,
            "prConcurrentLimit": 0,
            "prHourlyLimit": 0
        },
        {
            // with the JUnit API that the test retry extension builds against, so that JUnit stays in one PR
            "matchFileNames": ["langchain4j-parent/pom.xml", "internal/langchain4j-internal-test-retry/pom.xml"],
            "matchPackageNames": [
                "org.junit:*", "org.junit.jupiter:*", "org.testcontainers:*", "org.mockito:*", "org.assertj:*",
                "org.awaitility:*", "ch.qos.logback:*", "org.tinylog:*", "org.apache.logging.log4j:*"
            ],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "test dependencies",
            "prPriority": 3,
            "schedule": ["* 0-4 * * 1"],
            "updateNotScheduled": false,
            "prConcurrentLimit": 0,
            "prHourlyLimit": 0
        },
        {
            // the whole SDK monorepo groups, so that each group has one schedule
            "matchPackageNames": ["software.amazon.awssdk:*", "com.azure:*"],
            "matchUpdateTypes": ["minor", "patch"],
            "schedule": ["* 0-4 * * 1"],
            "updateNotScheduled": false,
            "prConcurrentLimit": 0,
            "prHourlyLimit": 0
        },
        {
            // Jackson parses untrusted JSON, so its updates must be the first to get a free PR slot
            "matchPackageNames": [
                "/^com\\.fasterxml\\.jackson[.:]/",
                "/^tools\\.jackson[.:]/"
            ],
            "prPriority": 10
        },
        {
            // these come from the same Google release train; updated separately, they fail dependency convergence
            "matchPackageNames": ["com.google.cloud:*"],
            "groupName": "Google Cloud libraries"
        },
        {
            // updated separately, they fail dependency convergence
            "matchPackageNames": ["com.github.docker-java:*"],
            "groupName": "docker-java"
        },
        {
            // the a2a SDK raises the versions this module pins for it; updated separately, they fail dependency convergence
            "matchFileNames": ["langchain4j-agentic-a2a/pom.xml"],
            "matchPackageNames": [
                "org.a2aproject.sdk:*",
                "com.google.protobuf:protobuf-java",
                "com.google.code.gson:gson",
                "com.google.errorprone:error_prone_annotations"
            ],
            "groupName": "a2a-java SDK"
        },
        {
            // the watsonx.ai SDK is released together with its JSON bindings; updated separately, the Jackson 3
            // integration tests would run one SDK version against the JSON binding of another
            "matchPackageNames": ["com.ibm.watsonx:*"],
            "groupName": "watsonx.ai SDK"
        },
        {
            // "_special_" versions are IBM hotfix builds, not regular releases
            "matchPackageNames": ["com.ibm.db2:jcc"],
            "allowedVersions": "!/_special_/"
        },
        {
            // 1.24+ no longer ships the native library for macOS on Intel, which would break in-process models there
            "matchPackageNames": ["com.microsoft.onnxruntime:*"],
            "allowedVersions": "(,1.24)",
            "groupName": "onnxruntime"
        },
        {
            // the module is built on the JDK 25 build of the 0.4 line: 0.5.0+ removed classes it uses (LastRunMetrics),
            // and the successor of GPULlama3.java is jitLLM (langchain4j-jitllm)
            "matchPackageNames": ["io.github.beehive-lab:gpu-llama3"],
            "allowedVersions": "/^0\\.4\\.\\d+-jdk25$/"
        },
        {
            // 5.6.0 has no jar: it only relocates to io.weaviate:client6, a new client with a different API,
            // so moving to it is a migration of the module, not a version update
            "matchPackageNames": ["io.weaviate:client"],
            "allowedVersions": "(,5.6)"
        },
        {
            // because of that relocation, Renovate also proposes replacing it with io.weaviate:client6 5.6.0,
            // a version that client6 does not have
            "matchPackageNames": ["io.weaviate:client"],
            "matchUpdateTypes": ["replacement"],
            "enabled": false
        },
        {
            // 1.9.0+ is built with Kotlin 2 and needs kotlin-stdlib 2.x, but langchain4j-kotlin stays on Kotlin 1.9
            // (kotlin.version) so that projects on Kotlin 1.9 can use it; lift this cap when it moves to Kotlin 2
            "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-coroutines-*"],
            "allowedVersions": "(,1.9)"
        },
        {
            // for the same reason, Kotlin code is compiled with language and API version 1.9; the compiler deprecates
            // it in 2.2.0 (a warning, which -Werror turns into an error) and drops it in 2.4.0; lift with the cap above
            "matchPackageNames": ["org.jetbrains.kotlin:kotlin-maven-plugin"],
            "allowedVersions": "(,2.2)"
        },
        {
            // the Milvus tests pin one image per server major version; a new major gets its own entry instead
            "matchDatasources": ["docker"],
            "matchPackageNames": ["milvusdb/milvus"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        }
    ],
    "customManagers": [
        {
            // the Milvus test image is a plain string, which no built-in manager detects
            "customType": "regex",
            "managerFilePatterns": [
                "/^langchain4j-(hibernate-)?milvus(-v2)?/src/test/java/.+IT\\.java$/",
                "/^\\.github/workflows/.+\\.ya?ml$/"
            ],
            "matchStrings": ["(?<depName>milvusdb/milvus):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
            "datasourceTemplate": "docker"
        }
    ]
}
