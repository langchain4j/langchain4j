<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-integration-tests-parent</artifactId>
        <version>1.24.0-beta34-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>langchain4j-integration-tests-test-assertions-spring</artifactId>
    <name>LangChain4j :: Integration Tests :: Test Assertions :: Spring</name>
    <description>Tests for the AI Service recorder and assertions of langchain4j-test in a Spring Boot application</description>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <properties>
        <excludedTestGroups>reactor</excludedTestGroups>
        <!-- like spring-boot-starter-parent, so that tool parameters keep their names -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <!-- the logback-classic of LangChain4j's parent must match the logback-core of Spring Boot 3.5.5 -->
        <logback.version>1.5.18</logback.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <!-- Import dependency management from Spring Boot -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.5.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>1.24.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-test</artifactId>
            <version>1.24.0-beta34-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>1.24.0-SNAPSHOT</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            AI Service methods that return a Flux or a Mono need langchain4j-reactor, which is released separately from
            this repository: a change in LangChain4j can break the released version until it is released again. So the
            tests that need it (tagged "reactor") run only with this profile, which the nightly builds turn on, like
            the spring-starter and quarkus-extension apps.
        -->
        <profile>
            <id>test-assertions-frameworks</id>
            <properties>
                <excludedTestGroups></excludedTestGroups>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>langchain4j-reactor</artifactId>
                    <version>1.22.0-beta32</version>
                    <scope>runtime</scope>
                    <exclusions>
                        <exclusion>
                            <groupId>dev.langchain4j</groupId>
                            <artifactId>langchain4j</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excludedTestGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
