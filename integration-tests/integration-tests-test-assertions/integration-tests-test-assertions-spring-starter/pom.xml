<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-integration-tests-parent</artifactId>
        <version>1.24.0-beta34-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>langchain4j-integration-tests-test-assertions-spring-starter</artifactId>
    <name>LangChain4j :: Integration Tests :: Test Assertions :: Spring Boot Starter</name>
    <description>Tests for the testing support of langchain4j-test with AI Services created by the LangChain4j Spring Boot starter</description>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <properties>
        <!-- like spring-boot-starter-parent, so that tool parameters keep their names -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <!-- the logback-classic of LangChain4j's parent must match the logback-core of Spring Boot 3.5.5 -->
        <logback.version>1.5.18</logback.version>
        <!-- the nightly build overrides these with the latest releases, see ../README.md -->
        <langchain4j-spring.version>1.22.0-beta32</langchain4j-spring.version>
        <spring-boot.version>3.5.5</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- the starter is released separately from this repository: run it on the LangChain4j of this build -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>1.24.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-core</artifactId>
                <version>1.24.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <!-- Import dependency management from Spring Boot -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
            <version>${langchain4j-spring.version}</version>
        </dependency>

        <dependency>
            <!-- so that AI Service methods can return Flux; released separately from this repository -->
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
            <version>${langchain4j-spring.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-test</artifactId>
            <version>1.24.0-beta34-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
