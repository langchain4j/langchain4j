# FloatTensor's static initializer reaches the Vector API, which is an incubator module
# on every supported JDK and is not supplied by the SDK's own flags.
--add-modules
jdk.incubator.vector
# TornadoVM 8.x binds its tornado.unittests module, which brings the SDK's JUnit Platform and Jupiter engine
# into the boot layer as named modules. Resolve Jupiter's params module from the SDK as well, so that the whole
# JUnit stack comes from one place instead of a classpath copy that cannot read the SDK modules' internals.
--add-modules
org.junit.jupiter.params
-Xms20g
-Xmx20g
-Djdk.module.showModuleResolution=false
-Dtornado.tvm.maxbytecodesize=65536
-Duse.tornadovm=true
-Dtornado.device.memory=20GB
-Dtornado.enable.fastMathOptimizations=true
-Dtornado.enable.mathOptimizations=false
-Dtornado.enable.nativeFunctions=fast
-Dtornado.loop.interchange=true
-Dtornado.eventpool.maxwaitevents=32000
